# Build machinery — everything here is regenerated by build_mac.sh / build_win.ps1.
buildenv/
build/
dist/
payload_seed/
repo/

# NEVER commit an app certificate. app.crt/app.key are the Leapmotor app's TLS pair, published at
# markoceri/leapmotor-certs and uploaded by each user in the setup wizard — not something this
# project redistributes. The build recipes exclude them, the build refuses to package one if it
# finds it, and this closes the third way in.
certs/
*.crt
*.key
*.p12

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# macOS
.DS_Store

# The working journal: machine addresses, SSH details and a running account of what broke and why.
# Useful to whoever is building this, but it is notes rather than documentation, and it names a
# particular laptop and VM. What a user or a contributor needs is in README.md.
STATO.md
firstrun/

